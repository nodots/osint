# Copy to `.env` (gitignored) next to docker-compose.yml on the VPS.

# Database (the compose db service is created with these). One PostGIS instance
# holds one database per vertical.
DB_USER=osint
DB_PASSWORD=change-me-to-a-strong-secret
UKRAINE_DB_NAME=ukraine_tracker
ELECTIONS_DB_NAME=elections_tracker

# Your domain — enables automatic HTTPS in Caddy. Leave blank to serve plain
# HTTP on :80 (e.g. while testing or if Cloudflare terminates TLS in front).
PUBLIC_DOMAIN=osint.nodots.com
# Used only for the API CORS headers (same-origin via the gateway makes this moot).
PUBLIC_ORIGIN=https://osint.nodots.com

# NASA FIRMS thermal layer (optional). Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# UCDP GED JSON API token (x-ucdp-access-token header). Only needed for the
# occasional UCDP refresh (see docker-compose.yml header). Request one at
# https://ucdp.uu.se/apidocs/.
UCDP_API_TOKEN=

# UTC wall-clock time (HH:MM) for the daily ukraine ingest. Default 07:30 is
# after GDELT publishes the prior day's export (~06:00 UTC), so each run
# captures the day that just ended rather than straddling the publish window.
INGEST_TIME_UTC=07:30

# --- elections vertical ---

# CourtListener API token (optional; raises rate limits for the litigation
# sources — anonymous access works for the daily window). Free account:
# https://www.courtlistener.com/sign-in/
COURTLISTENER_TOKEN=

# UTC wall-clock time for the daily elections ingest (staggered after the
# ukraine run to spread load on the shared db).
ELECTIONS_INGEST_TIME_UTC=08:00

# Email digest (optional; unset disables it). Sent after the daily run only
# when material risk changes or new federal actions/rulings appeared (§38:
# notify only when something meaningful changes). SMTP_URL example:
# smtps://user:pass@smtp.example.com:465 — or "console" to print instead.
SMTP_URL=
DIGEST_FROM=
DIGEST_TO=
# Minimum |risk delta| for a race to appear in the digest.
DIGEST_RISK_DELTA=0.02

# OpenStates v3 API key (optional; enables the state election-legislation
# source). Free: https://open.pluralpolicy.com/accounts/profile/
OPENSTATES_API_KEY=

# Container path to the MEDSL house-returns file for the weekly Sunday
# ratings refresh (mount the file into elections-worker when setting this).
RATINGS_FILE=
