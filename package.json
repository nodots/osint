{
  "name": "nodots-osint",
  "version": "0.0.0",
  "private": true,
  "description": "Nodots OSINT platform — Ukraine conflict, election-integrity, and naval vessel trackers as verticals of one platform",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:elections": "pnpm --parallel --stream --filter @elections-tracker/api --filter @elections-tracker/web dev",
    "dev:ukraine": "pnpm --parallel --stream --filter @ukraine-tracker/api --filter @ukraine-tracker/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "ukraine:db:migrate": "pnpm --filter @ukraine-tracker/api db:migrate",
    "ukraine:seed:mock": "pnpm --filter @ukraine-tracker/worker seed:mock",
    "elections:db:migrate": "pnpm --filter @elections-tracker/api db:migrate",
    "clean": "pnpm -r exec rm -rf dist .tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
