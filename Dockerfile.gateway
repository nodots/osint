# Gateway image: build every vertical's Vite SPA, then serve them all from one
# Caddy (auto-HTTPS) with path routing — /ukraine, /elections — and /api/<vertical>/*
# reverse-proxied to the matching api service (same origin → no CORS).
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/ukraine-shared/package.json packages/ukraine-shared/
COPY packages/elections-shared/package.json packages/elections-shared/
COPY apps/ukraine-api/package.json apps/ukraine-api/
COPY apps/ukraine-worker/package.json apps/ukraine-worker/
COPY apps/ukraine-web/package.json apps/ukraine-web/
COPY apps/elections-api/package.json apps/elections-api/
COPY apps/elections-web/package.json apps/elections-web/
RUN pnpm install --frozen-lockfile

COPY . .
# Same-origin API paths; Caddy proxies /api/<vertical>/* to each api container.
RUN pnpm --filter @ukraine-tracker/shared build \
 && pnpm --filter @elections-tracker/shared build \
 && VITE_API_BASE_URL=/api/ukraine pnpm --filter @ukraine-tracker/web build \
 && VITE_API_BASE_URL=/api/elections pnpm --filter @elections-tracker/web build

FROM caddy:2-alpine
COPY apps/gateway/Caddyfile /etc/caddy/Caddyfile
COPY apps/gateway/site /srv
COPY --from=build /app/apps/ukraine-web/dist /srv/ukraine
COPY --from=build /app/apps/elections-web/dist /srv/elections
